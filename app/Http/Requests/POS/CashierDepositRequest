<?php

namespace App\Http\Requests\POS;

use Illuminate\Foundation\Http\FormRequest;

class CashierDepositRequest extends FormRequest
{
    public function authorize(): bool
    {
        return auth()->check();
    }

    public function rules(): array
    {
        return [
            'destination_account_id' => [
                'required',
                'integer',
                'exists:chart_of_accounts,id',
            ],

            'amount' => [
                'required',
                'numeric',
                'min:0.01',
            ],

            'deposited_at' => [
                'required',
                'date',
            ],

            'note' => [
                'nullable',
                'string',
                'max:1000',
            ],

            'warehouse_id' => [
                'required',
                'integer',
                'exists:warehouses,id',
            ],
        ];
    }

    public function messages(): array
    {
        return [
            'destination_account_id.required' =>
                'Destination account wajib dipilih.',

            'destination_account_id.integer' =>
                'Destination account tidak valid.',

            'destination_account_id.exists' =>
                'Destination account tidak ditemukan.',

            'amount.required' =>
                'Deposit amount wajib diisi.',

            'amount.numeric' =>
                'Deposit amount harus berupa angka.',

            'amount.min' =>
                'Deposit amount harus lebih besar dari 0.',

            'deposited_at.required' =>
                'Deposit date wajib diisi.',

            'deposited_at.date' =>
                'Format deposit date tidak valid.',

            'note.string' =>
                'Note harus berupa teks.',

            'note.max' =>
                'Note maksimal 1000 karakter.',
        ];
    }
}